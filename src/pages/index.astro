---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import Marquee from '../components/Marquee.astro';
import Motif from '../components/Motif.astro';
import Process from '../components/Process.astro';
import CapabilityArt from '../components/CapabilityArt.astro';
import InsightCard from '../components/InsightCard.astro';
import { getCollection } from 'astro:content';
const caps = (await getCollection('capabilities')).sort((a, b) => a.data.order - b.data.order);
const inds = (await getCollection('industries')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('insights')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const capTitle = Object.fromEntries(caps.map((c) => [c.id, c.data.title]));
---
<Base seoTitle="Enterprise IT Solutions Provider in Raleigh, NC | Quintas" description="Raleigh, NC enterprise IT partner for cloud, data center infrastructure, cybersecurity, data & AI and managed services. Serving manufacturers and enterprises across the US.">
  <section class="hero">
    <div class="wrap hero-grid2">
      <div class="hero-copy">
        <span class="eyebrow">Enterprise technology partner</span>
        <h1>Engineering enterprise technology for <span class="hl">what’s next.</span></h1>
        <p class="lead muted">Quintas helps organisations plan, build and run the technology their business depends on, from infrastructure and cloud to security, data and digital commerce.</p>
        <div class="actions">
          <a href="/contact/" class="btn btn-primary">Start a project <span class="arrow">→</span></a>
          <a href="/capabilities/" class="btn btn-ghost">Explore capabilities</a>
        </div>
      </div>
      <div class="hero-art"><Motif /></div>
    </div>
    <div class="wrap">
      <ul class="facts">
        <li><strong>60+ years</strong><span>combined industry experience</span></li>
        <li><strong>End to end</strong><span>strategy, procurement, build and support</span></li>
        <li><strong>Vendor neutral</strong><span>the right platform, not the one we resell</span></li>
        <li><strong>Raleigh, NC</strong><span>serving enterprises across the US</span></li>
      </ul>
    </div>
  </section>

  <section class="section white">
    <div class="wrap">
      <div class="section-head reveal">
        <div><span class="eyebrow">What we do</span><h2>Six capabilities. One accountable partner.</h2></div>
        <p class="muted">Each practice works on its own or as part of a wider programme, so strategy, delivery and support never fall between vendors.</p>
      </div>
      <div class="grid g3 caps">
        {caps.map((c, i) => (
          <a class="cap reveal" href={`/capabilities/${c.id}/`}>
            <div class="cap-art"><CapabilityArt id={c.id} /></div>
            <span class="cn">{String(i + 1).padStart(2, '0')}</span>
            <h3>{c.data.title}</h3>
            <p>{c.data.summary}</p>
            <span class="link-arrow">Explore <span>→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Marquee />

  <section class="section dark">
    <div class="wrap">
      <div class="section-head reveal">
        <div><span class="eyebrow">How we deliver</span><h2>A predictable path from plan to production.</h2></div>
        <p class="muted">The same six-step model runs every engagement, whatever its size, so you always know what happens next.</p>
      </div>
      <Process />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div><span class="eyebrow">Why Quintas</span><h2>Senior people. No hand-offs.</h2></div>
        <p class="muted">The architects who design your programme are the ones who deliver it, and we stay to support what we build.</p>
      </div>
      <div class="grid g4">
        <div class="wcard reveal"><h3>Enterprise first</h3><p>Planned, governed and documented to the standard business-critical systems need.</p></div>
        <div class="wcard reveal"><h3>Vendor neutral</h3><p>Recommendations follow your requirements, across leading platforms and OEMs.</p></div>
        <div class="wcard reveal"><h3>End-to-end delivery</h3><p>Strategy, procurement, engineering, migration and support from one team.</p></div>
        <div class="wcard reveal"><h3>Clear accountability</h3><p>Defined milestones, sign-offs and reporting you can share with leadership.</p></div>
      </div>
    </div>
  </section>

  <section class="section white">
    <div class="wrap">
      <div class="section-head reveal">
        <div><span class="eyebrow">Industries</span><h2>Experience across the sectors we serve.</h2></div>
        <a class="link-arrow" href="/industries/">All industries →</a>
      </div>
      <div class="grid g4">
        {inds.map((i) => (
          <a class="card ind reveal" href={`/industries/${i.id}/`}>
            <span class="bar" aria-hidden="true"></span>
            <h3>{i.data.title}</h3>
            <p>{i.data.summary}</p>
            <span class="link-arrow">Learn more <span>→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div><span class="eyebrow">Insights</span><h2>Thinking from our practice leads.</h2></div>
        <a class="link-arrow" href="/insights/">All insights →</a>
      </div>
      <div class="grid g3">
        {posts.map((p) => <InsightCard post={p} capTitle={capTitle[p.data.capability]} />)}
      </div>
    </div>
  </section>

  <CTA />
</Base>
<style>
  .hero { background: var(--paper); padding: clamp(56px, 8vw, 112px) 0 0; overflow: hidden; }
  .hero-grid2 { display: grid; grid-template-columns: 1.15fr .85fr; gap: 48px; align-items: center; }
  .hero h1 { font-size: clamp(2.6rem, 5.8vw, 5.2rem); max-width: 14ch; }
  .hl { color: var(--accent); }
  .hero .lead { margin-bottom: 36px; max-width: 50ch; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-ghost { color: var(--ink); }
  .btn-ghost:hover { background: var(--ink); color: #fff; }
  .hero-art { margin-right: -80px; }
  @media (max-width: 960px) { .hero-grid2 { grid-template-columns: 1fr; } .hero-art { max-width: 420px; margin: 0 0 0 auto; } }
  .facts { list-style: none; margin: clamp(48px, 7vw, 88px) 0 0; padding: 28px 0 40px; border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .facts strong { display: block; font-family: var(--display); font-stretch: 112%; font-size: 1.3rem; letter-spacing: -0.01em; }
  .facts span { color: var(--muted); font-size: .95rem; }
  @media (max-width: 960px) { .facts { grid-template-columns: 1fr 1fr; } }

  .caps { gap: 20px; }
  .cap { display: flex; flex-direction: column; padding: 28px; border-radius: 18px; background: var(--paper); text-decoration: none; transition: background .3s, color .3s, transform .3s; min-height: 420px; }
  .cap-art { background: var(--ink); border-radius: 12px; padding: 18px 22px; margin-bottom: 28px; transition: background .3s; }
  .cap .cn { font-family: var(--display); font-size: .85rem; color: var(--accent); margin-bottom: 8px; }
  .cap h3 { font-family: var(--display); font-stretch: 112%; font-size: 1.45rem; }
  .cap p { color: var(--muted); }
  .cap .link-arrow { margin-top: auto; }
  .cap:hover { background: var(--ink); color: #fff; transform: translateY(-4px); }
  .cap:hover .cap-art { background: #062950; }
  .cap:hover p { color: #9fb0cc; }
  .cap:hover .cn, .cap:hover .link-arrow { color: #6fa3ff; }
  @media (max-width: 640px) { .cap { min-height: 0; } }

  .wcard { border-top: 2px solid var(--accent); padding-top: 24px; }
  .wcard p { color: var(--muted); }
  .ind { min-height: 280px; position: relative; padding-top: 44px; }
  .ind .bar { position: absolute; top: 24px; left: 30px; width: 36px; height: 6px; background: var(--accent); transform: skewX(-45deg); }
</style>
