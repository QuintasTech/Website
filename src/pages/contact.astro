---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../site';
import { getCollection } from 'astro:content';
const caps = (await getCollection('capabilities')).sort((a, b) => a.data.order - b.data.order);
const action = site.formEndpoint || `mailto:${site.email}`;
---
<Base title="Contact" description="Start a project with Quintas Technology Partners.">
  <PageHero eyebrow="Contact" title="Tell us about your project." lead="A senior architect will get back to you within one business day." />
  <section class="section">
    <div class="wrap split">
      <form class="form" action={action} method="post" enctype={site.formEndpoint ? undefined : 'text/plain'}>
        <div class="row2">
          <label>Name<input name="name" required autocomplete="name" /></label>
          <label>Work email<input name="email" type="email" required autocomplete="email" /></label>
        </div>
        <div class="row2">
          <label>Company<input name="company" required autocomplete="organization" /></label>
          <label>Phone <span class="opt">(optional)</span><input name="phone" type="tel" autocomplete="tel" /></label>
        </div>
        <label>What can we help with?
          <select name="topic">
            {caps.map((c) => <option>{c.data.title}</option>)}
            <option>Something else</option>
          </select>
        </label>
        <label>Project details<textarea name="message" rows="6" required placeholder="Goals, timeline, systems involved"></textarea></label>
        <p class="small muted">By sending this form you agree to our <a href="/privacy/">privacy policy</a>.</p>
        <button class="btn btn-primary" type="submit">Send message <span class="arrow">→</span></button>
      </form>
      <aside class="side">
        <h3>Prefer email?</h3>
        <p><a class="link-arrow" href={`mailto:${site.email}`}>{site.email}</a></p>
        {site.phone && <><h3>Call us</h3><p><a href={`tel:${site.phone}`}>{site.phone}</a></p></>}
        <h3>Office</h3>
        <p class="muted">{site.address.map((l) => <>{l}<br /></>)}</p>
      </aside>
    </div>
  </section>
</Base>
<style>
  .split { display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(40px, 6vw, 96px); }
  @media (max-width: 960px) { .split { grid-template-columns: 1fr; } }
  .form { display: grid; gap: 20px; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(24px, 4vw, 44px); }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (max-width: 640px) { .row2 { grid-template-columns: 1fr; } }
  label { display: grid; gap: 8px; font-weight: 600; font-size: .95rem; }
  .opt { font-weight: 400; color: var(--muted); }
  input, select, textarea { font: inherit; font-weight: 400; padding: 13px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--paper); width: 100%; }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--accent); border-color: transparent; }
  .small { font-size: .88rem; margin: 0; }
  .form .btn { justify-self: start; border: 0; cursor: pointer; font: inherit; font-weight: 600; }
  .side h3 { font-size: 1.05rem; margin-top: 32px; }
  .side h3:first-child { margin-top: 0; }
</style>
