---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../site';
---
<Base title="Privacy policy" description="How Quintas Technology Partners handles personal information.">
  <PageHero eyebrow="Legal" title="Privacy policy" lead="Draft for legal review. Last updated November 2026." />
  <section class="section white">
    <div class="wrap prose">
      <h2>What we collect</h2>
      <p>When you contact us we collect the details you provide, such as your name, work email, company, phone number and message.</p>
      <h2>How we use it</h2>
      <p>We use this information only to respond to your enquiry and, where relevant, to discuss a potential engagement. We do not sell personal information.</p>
      <h2>Retention</h2>
      <p>We keep enquiry information for as long as needed to respond and maintain our business records, then delete it.</p>
      <h2>Your choices</h2>
      <p>You can ask us to access, correct or delete your information at any time by emailing <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </section>
</Base>
