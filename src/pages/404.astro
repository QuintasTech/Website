---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Page not found">
  <PageHero eyebrow="404" title="This page has moved or doesn’t exist." lead="Try one of these instead.">
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:32px">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-ghost" href="/capabilities/">Capabilities</a>
      <a class="btn btn-ghost" href="/contact/">Contact</a>
    </div>
  </PageHero>
</Base>
