---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';
interface Props {
  title?: string;
  seoTitle?: string; // full <title>, used as-is
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}
const {
  title,
  seoTitle,
  description = 'Raleigh, NC enterprise technology partner for cloud, data center infrastructure, cybersecurity, data and AI, commerce and managed services, serving enterprises across the US.',
  image = '/og-image.png',
  type = 'website',
  noindex = false,
  schema = [],
} = Astro.props;
const fullTitle = seoTitle ?? (title ? `${title} | ${site.name}` : `Enterprise IT Solutions Provider in Raleigh, NC | ${site.short}`);
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const isStaging = import.meta.env.PUBLIC_SITE_ENV === 'staging';
const origin = Astro.site!.origin;
const orgId = `${origin}/#organization`;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': orgId,
      name: site.name,
      alternateName: site.short,
      url: `${origin}/`,
      logo: `${origin}/brand/full-color.png`,
      image: `${origin}/og-image.png`,
      email: site.email,
      ...(site.phone ? { telephone: site.phone } : {}),
      description: 'Enterprise technology partner for cloud, data center infrastructure, cybersecurity, data and AI, digital commerce and managed operations.',
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.street,
        addressLocality: site.city,
        addressRegion: site.region,
        postalCode: site.postalCode,
        addressCountry: 'US',
      },
      areaServed: [
        { '@type': 'State', name: 'North Carolina' },
        { '@type': 'Country', name: 'United States' },
      ],
      knowsAbout: site.services,
      ...(site.sameAs.length ? { sameAs: site.sameAs } : {}),
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}/#website`,
      url: `${origin}/`,
      name: site.name,
      publisher: { '@id': orgId },
    },
    ...schema,
  ],
};
---
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(isStaging || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,500..700&family=Inter+Tight:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      const io = 'IntersectionObserver' in window ? new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io && io.unobserve(e.target); } }), { rootMargin: '0px 0px -6% 0px' }) : null;
      document.documentElement.classList.add('js');
      document.querySelectorAll('.reveal').forEach((el) => io ? io.observe(el) : el.classList.add('in'));
    </script>
  </body>
</html>
