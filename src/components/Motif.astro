---
// Brand motif: the diagonal strokes from the Quintas "Q", used as large graphic shapes.
const { variant = 'hero' } = Astro.props;
---
<svg class={`motif motif-${variant}`} viewBox="0 0 600 520" aria-hidden="true">
  <g class="m1"><polygon points="140,0 300,0 600,300 600,460" fill="#001d3f"/></g>
  <g class="m2"><polygon points="40,120 160,120 520,480 400,480" fill="#003a8c"/></g>
  <g class="m3"><polygon points="240,160 360,160 600,400 600,520 480,520" fill="#0057d9"/></g>
  <circle class="m4" cx="150" cy="380" r="56" fill="none" stroke="#0057d9" stroke-width="18"/>
</svg>
<style>
  .motif { display: block; width: 100%; height: auto; }
  .motif polygon, .motif circle { transform-box: fill-box; }
  .motif-hero .m1 { animation: slide 1.1s cubic-bezier(.2,.7,.2,1) both; }
  .motif-hero .m2 { animation: slide 1.1s .12s cubic-bezier(.2,.7,.2,1) both; }
  .motif-hero .m3 { animation: slide 1.1s .24s cubic-bezier(.2,.7,.2,1) both; }
  .motif-hero .m4 { animation: pop 1s .5s cubic-bezier(.2,.7,.2,1) both; transform-origin: 150px 380px; }
  @keyframes slide { from { transform: translate(-60px, -60px); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes pop { from { transform: scale(.6); opacity: 0; } to { transform: none; opacity: 1; } }
  .motif-quiet { opacity: .35; }
  .motif-quiet .m1 { fill: #0a3a7a; }
  @media (prefers-reduced-motion: reduce) { .motif * { animation: none !important; } }
</style>
