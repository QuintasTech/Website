---
const { title = 'Let’s build what’s next.', text = 'Tell us where you’re headed. A senior architect will get back to you within one business day.' } = Astro.props;
---
<section class="cta-band">
  <div class="wrap inner">
    <div>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="actions">
      <a href="/contact/" class="btn btn-primary">Start a project <span class="arrow">→</span></a>
      <a href="/capabilities/" class="btn btn-ghost">Explore capabilities</a>
    </div>
  </div>
</section>
<style>
  .cta-band { background: var(--accent); color: #fff; padding: clamp(64px, 8vw, 112px) 0; }
  .inner { display: flex; justify-content: space-between; align-items: end; gap: 40px; flex-wrap: wrap; }
  h2 { max-width: 14ch; }
  .lead { color: #dfe7ff; margin: 0; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: #fff; color: var(--ink); }
  .btn-primary:hover { background: var(--ink); color: #fff; }
  .btn-ghost:hover { background: #fff; color: var(--accent); }
</style>
