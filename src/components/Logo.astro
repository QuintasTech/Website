---
// Quintas logo lockup, cut from the official logo file (brand-source/quintas-logo-original.png).
// variant: 'white' for dark backgrounds, 'color' for light ones.
const { variant = 'white', stacked = false } = Astro.props;
---
{stacked ? (
  <img class="stacked" src={`/brand/full-${variant}.png`} alt="Quintas Technology Partners" width="417" height="240" />
) : (
  <span class="logo">
    <img src={`/brand/mark-${variant}.png`} alt="" width="102" height="96" />
    <img src={`/brand/wordmark-${variant}.png`} alt="Quintas Technology Partners" width="383" height="72" />
  </span>
)}
<style>
  .logo { display: inline-flex; align-items: center; gap: 12px; }
  .logo img:first-child { height: 44px; width: auto; }
  .logo img:last-child { height: 32px; width: auto; }
  .stacked { height: 96px; width: auto; }
</style>
