<canvas class="hero-canvas" aria-hidden="true"></canvas>
<script>
  const c = document.querySelector<HTMLCanvasElement>('.hero-canvas');
  if (c) {
    const ctx = c.getContext('2d')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let w = 0, h = 0, pts: { x: number; y: number; vx: number; vy: number }[] = [];
    const size = () => {
      const r = c.getBoundingClientRect(); const d = Math.min(devicePixelRatio || 1, 2);
      w = r.width; h = r.height; c.width = w * d; c.height = h * d; ctx.setTransform(d, 0, 0, d, 0, 0);
      const n = Math.round(Math.min(90, (w * h) / 14000));
      pts = Array.from({ length: n }, () => ({ x: Math.random() * w, y: Math.random() * h, vx: (Math.random() - .5) * .35, vy: (Math.random() - .5) * .35 }));
    };
    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      for (const p of pts) {
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0 || p.x > w) p.vx *= -1; if (p.y < 0 || p.y > h) p.vy *= -1;
      }
      for (let i = 0; i < pts.length; i++) for (let j = i + 1; j < pts.length; j++) {
        const a = pts[i], b = pts[j], dx = a.x - b.x, dy = a.y - b.y, d = dx * dx + dy * dy;
        if (d < 22000) { ctx.strokeStyle = `rgba(111,163,255,${(1 - d / 22000) * .35})`; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke(); }
      }
      for (const p of pts) { ctx.fillStyle = 'rgba(160,195,255,.9)'; ctx.beginPath(); ctx.arc(p.x, p.y, 1.6, 0, 7); ctx.fill(); }
      if (!reduce) requestAnimationFrame(draw);
    };
    size(); draw(); addEventListener('resize', size);
  }
</script>
<style>
  .hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
</style>
