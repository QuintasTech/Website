---
const items = ['Microsoft Azure', 'AWS', 'Cisco', 'Dell Technologies', 'HPE', 'Nutanix', 'VMware', 'Fortinet', 'Shopify Plus', 'Salesforce Commerce Cloud', 'Adobe Commerce', 'commercetools'];
---
<div class="marquee" aria-label="Technologies we work with">
  <div class="track">
    {[0, 1].map((k) => <ul aria-hidden={k === 1 ? 'true' : undefined}>{items.map((i) => <li>{i}</li>)}</ul>)}
  </div>
</div>
<style>
  .marquee { overflow: hidden; border-block: 1px solid var(--line); background: var(--white); padding: 26px 0; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .track { display: flex; width: max-content; animation: scroll 50s linear infinite; }
  ul { display: flex; gap: 64px; padding: 0 32px; margin: 0; list-style: none; }
  li { font-weight: 700; font-size: 1.35rem; letter-spacing: -0.02em; color: #8a94a8; white-space: nowrap; }
  @keyframes scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; } }
</style>
