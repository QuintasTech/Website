---
const { eyebrow, title, lead, crumbs = [] } = Astro.props;
---
<section class="dark page-hero">
  <div class="hero-grid"></div><div class="hero-glow"></div>
  <div class="wrap relative">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        {crumbs.map((c) => <><a href={c.href}>{c.label}</a><span aria-hidden="true">/</span></>)}
      </nav>
    )}
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
<style>
  .crumbs { display: flex; gap: 10px; font-size: .9rem; color: #8590a8; margin-bottom: 28px; }
  .crumbs a { text-decoration: none; color: #b9c1d3; }
  .crumbs a:hover { color: #fff; }
</style>
