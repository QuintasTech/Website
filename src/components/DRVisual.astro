---
// Animated illustration: primary site replicating to a recovery site.
const racks = [0, 1, 2];
const leds = [0, 1, 2, 3, 4, 5, 6];
---
<div class="dr-visual" aria-hidden="true">
  <svg viewBox="0 0 640 440" role="presentation">
    <defs>
      <linearGradient id="dr-rack" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0d3a73"/><stop offset="1" stop-color="#072650"/></linearGradient>
      <linearGradient id="dr-floor" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#4d8cff" stop-opacity="0"/><stop offset=".5" stop-color="#4d8cff" stop-opacity=".5"/><stop offset="1" stop-color="#4d8cff" stop-opacity="0"/></linearGradient>
      <filter id="dr-glow"><feGaussianBlur stdDeviation="3"/></filter>
    </defs>
    <!-- sites -->
    {[{ x: 30, label: 'PRIMARY SITE' }, { x: 390, label: 'RECOVERY SITE' }].map((s, si) => (
      <g>
        <rect x={s.x} y="70" width="220" height="250" rx="16" fill="#041c3d" stroke="#1d4a8a"/>
        <text x={s.x + 20} y="100" fill="#8fb4ff" font-size="12" font-weight="600" letter-spacing="2">{s.label}</text>
        <circle cx={s.x + 196} cy="96" r="5" fill="#3ddc97"><animate attributeName="opacity" values="1;.3;1" dur="2s" repeatCount="indefinite" begin={`${si * .7}s`} /></circle>
        {racks.map((r) => (
          <g>
            <rect x={s.x + 20 + r * 64} y="120" width="52" height="180" rx="6" fill="url(#dr-rack)" stroke="#1d4a8a"/>
            {leds.map((l) => (
              <g>
                <rect x={s.x + 28 + r * 64} y={132 + l * 23} width="36" height="14" rx="3" fill="#0a2f5e"/>
                <circle cx={s.x + 34 + r * 64} cy={139 + l * 23} r="2.2" fill={(r + l + si) % 3 === 0 ? '#4d8cff' : '#3ddc97'}>
                  <animate attributeName="opacity" values="1;.25;1" dur={`${1.2 + ((r * 7 + l * 3 + si) % 5) * .35}s`} repeatCount="indefinite" />
                </circle>
                <rect x={s.x + 41 + r * 64} y={137 + l * 23} width={14 + ((r + l) % 3) * 3} height="3" rx="1.5" fill="#1f5bb5"/>
              </g>
            ))}
          </g>
        ))}
        <rect x={s.x} y="330" width="220" height="3" fill="url(#dr-floor)"/>
      </g>
    ))}
    <!-- replication link -->
    <path id="dr-link" d="M250 160 C 320 130, 320 130, 390 160" fill="none" stroke="#4d8cff" stroke-width="2" stroke-dasharray="6 7" opacity=".7">
      <animate attributeName="stroke-dashoffset" from="26" to="0" dur="1s" repeatCount="indefinite"/>
    </path>
    <path d="M250 260 C 320 290, 320 290, 390 260" fill="none" stroke="#3ddc97" stroke-width="2" stroke-dasharray="6 7" opacity=".45">
      <animate attributeName="stroke-dashoffset" from="0" to="26" dur="1.4s" repeatCount="indefinite"/>
    </path>
    {[0, .6, 1.2].map((b) => (
      <circle r="5" fill="#8fb4ff" filter="url(#dr-glow)">
        <animateMotion dur="1.8s" repeatCount="indefinite" begin={`${b}s`} path="M250 160 C 320 130, 320 130, 390 160" />
      </circle>
    ))}
    <text x="320" y="118" text-anchor="middle" fill="#8fb4ff" font-size="11" font-weight="600" letter-spacing="1.5">REPLICATION</text>
    <text x="320" y="312" text-anchor="middle" fill="#3ddc97" font-size="11" font-weight="600" letter-spacing="1.5">FAILBACK</text>
    <!-- status cards -->
    <g class="float-a">
      <rect x="60" y="356" width="250" height="56" rx="12" fill="#ffffff"/>
      <circle cx="86" cy="384" r="11" fill="#3ddc97"/>
      <path d="M81 384 l4 4 l7 -8" stroke="#fff" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      <text x="106" y="379" fill="#001d3f" font-size="13" font-weight="700">Failover test passed</text>
      <text x="106" y="397" fill="#56637a" font-size="11">Recovery objectives met</text>
    </g>
    <g class="float-b">
      <rect x="350" y="20" width="250" height="56" rx="12" fill="#ffffff"/>
      <rect x="364" y="34" width="28" height="28" rx="8" fill="#e6efff"/>
      <path d="M371 52 h14 M371 46 h14 M371 40 h9" stroke="#0057d9" stroke-width="2.2" stroke-linecap="round"/>
      <text x="404" y="45" fill="#001d3f" font-size="13" font-weight="700">Relocation runbook</text>
      <text x="404" y="63" fill="#56637a" font-size="11">Every rack tracked and signed off</text>
    </g>
  </svg>
</div>
<style>
  .dr-visual svg { width: 100%; height: auto; overflow: visible; font-family: var(--font); }
  .float-a { animation: floatY 6s ease-in-out infinite; }
  .float-b { animation: floatY 7s ease-in-out infinite reverse; }
  @keyframes floatY { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  @media (prefers-reduced-motion: reduce) { .float-a, .float-b { animation: none; } }
</style>
